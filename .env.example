# Copy to .env for local development. On Heroku, set these as config vars.

# Postgres connection string. Locally: postgres://localhost:5432/html_plan_host
# On Heroku this is provisioned automatically by the Postgres addon.
DATABASE_URL=postgres://localhost:5432/html_plan_host

# 32+ random bytes, used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Bearer token the publish CLI uses to write plans. Generate with:
#   openssl rand -hex 32
PUBLISH_TOKEN=

# Auth is implicit. Set BOTH Heroku OAuth vars to require sign-in; leave them
# unset to serve open reads (no login). Create a client with:
#   heroku clients:create "<name>" "https://<your-app-url>/auth/callback"
# which prints HEROKU_OAUTH_ID and HEROKU_OAUTH_SECRET.
HEROKU_OAUTH_ID=
HEROKU_OAUTH_SECRET=

# Who may read plans, as comma-separated glob patterns matched against the
# signed-in Heroku account email. Required whenever the HEROKU_OAUTH_* vars
# above are set.
#   *.salesforce.com, *.heroku.com   domain and its subdomains
#   someone@heroku.com               one specific person
#   *                                any authenticated Heroku account
ALLOWED_EMAILS=

# Optional. Forces the OAuth redirect/base URL instead of deriving it from the
# request. Set this on Heroku to your canonical app URL, e.g.
#   https://milad-plans.herokuapp.com
BASE_URL=

# Local dev port (Heroku sets PORT automatically).
PORT=3000

# Visual theme applied to the chrome pages. One of:
#   zinc, editorial, linear, brutalist, vercel, warm, glass
# Defaults to zinc. An unknown value fails fast at boot.
THEME=zinc
