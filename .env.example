# Copy to .env for local development. On Heroku, set these as config vars.

# Postgres connection string. Locally: postgres://localhost:5432/html_plan_host
# On Heroku this is provisioned automatically by the Postgres addon.
DATABASE_URL=postgres://localhost:5432/html_plan_host

# 32+ random bytes, used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Bearer token the publish CLI uses to write plans. Generate with:
#   openssl rand -hex 32
PUBLISH_TOKEN=

# Set to "false" to open read routes with no Google sign-in (useful before
# OAuth is set up). Anything else (or unset) keeps SSO on. When false, the
# GOOGLE_* vars below are not required.
AUTH_ENABLED=true

# Google OAuth 2.0 web client credentials (console.cloud.google.com > Credentials).
# Required only when AUTH_ENABLED is not false.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated email domains allowed to read plans.
ALLOWED_EMAIL_DOMAINS=salesforce.com,heroku.com

# Optional. Forces the OAuth redirect/base URL instead of deriving it from the
# request. Set this on Heroku to your canonical app URL, e.g.
#   https://milad-plans.herokuapp.com
BASE_URL=

# Local dev port (Heroku sets PORT automatically).
PORT=3000
