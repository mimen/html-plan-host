#!/usr/bin/env python3
import argparse
import io
from pathlib import Path
import re
import subprocess
import tarfile
import tempfile
import urllib.request

parser = argparse.ArgumentParser(description='Install a pinned html-plan-host package directly from GitHub.')
parser.add_argument('--revision', required=True)
parser.add_argument('--url', required=True)
parser.add_argument('--token-ref', required=True)
args = parser.parse_args()
if not re.fullmatch('[0-9a-f]{40}', args.revision):
    parser.error('--revision must be a full commit SHA')
root = Path.home() / '.local/share/html-plan-host/packages'
release = root / args.revision
if release.exists():
    if not (release / '.release-revision').is_file() or (release / '.release-revision').read_text().strip() != args.revision:
        raise SystemExit('Existing package directory is not a recognized release')
else:
    url = 'https://api.github.com/repos/mimen/html-plan-host/tarball/' + args.revision
    request = urllib.request.Request(url, headers={'User-Agent': 'html-plan-host-installer'})
    payload = urllib.request.urlopen(request, timeout=60).read()
    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as archive:
        members = archive.getmembers()
        prefix = members[0].name.split('/')[0]
        for member in members:
            parts = Path(member.name).parts
            if not parts or parts[0] != prefix or '..' in parts or member.issym() or member.islnk() or not (member.isfile() or member.isdir()):
                raise SystemExit('Archive contains unsupported paths or links')
        root.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.stage.', dir=root) as temporary:
            staging = Path(temporary) / 'package'
            staging.mkdir()
            for member in members:
                relative = Path(*Path(member.name).parts[1:])
                destination = staging / relative
                if member.isdir():
                    destination.mkdir(parents=True, exist_ok=True)
                else:
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    with archive.extractfile(member) as source:
                        destination.write_bytes(source.read())
                    destination.chmod(member.mode & 0o755)
            (staging / '.release-revision').write_text(args.revision + '\n')
            staging.rename(release)
subprocess.run(['python3', str(release / 'bin/install-agent'), '--url', args.url, '--token-ref', args.token_ref], check=True)
